# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/vehicle_rental_system

# AI teammate's Java service (which in turn calls the Python ai-service for trained predictions)
AI_SERVICE_URL=http://localhost:8081

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Simulated payment gateway (per proposal: real gateway not required for academic project)
PAYMENT_GATEWAY_MODE=simulated

# Email (optional - for booking/payment notifications, Minor Function 4)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Rental.lk <no-reply@rental.lk>"

# Frontend origin (CORS)
CLIENT_URL=http://localhost:3000
